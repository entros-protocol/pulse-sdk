# Pin peer-dependency resolution to npm's default, so the lockfile describes the
# real dependency graph regardless of the machine it was generated on.
#
# Without this, a user-level `legacy-peer-deps=true` silently omits peer entries
# from package-lock.json. That produced a lockfile `npm ci` could not install in
# any default environment, which went unnoticed until CI existed to run it.
#
# entros-mobile and entros.io deliberately set the opposite, because the
# @solana-mobile wallet-adapter packages declare react-native as a required peer
# and npm would otherwise install the whole framework into a web app. This
# package has no such conflict, so the accurate graph is the one to record.
legacy-peer-deps=false
